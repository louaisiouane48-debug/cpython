import tkinter as tk
from tkinter import messagebox

# إنشاء نافذة البرنامج
root = tk.Tk()
root.title("Shipping Management Software")
root.geometry("600x600")

# ---------- الدوال ----------
def add_shipment():
    name = name_entry.get()
    phone = phone_entry.get()
    city = city_entry.get()
    product = product_entry.get()
    quantity = quantity_entry.get()
    weight = weight_entry.get()
    value = value_entry.get()
    fee = fee_entry.get()

    if not (name and phone and product and quantity and weight):
        messagebox.showwarning("تنبيه", "يرجى ملء جميع الخانات المهمة")
        return

    shipment = f"""
    ========================
    Customer Name: {name}
    Phone: {phone}
    City: {city}
    ------------------------
    Product: {product}
    Quantity: {quantity}
    Weight: {weight} kg
    Value: ${value}
    Shipping Fee: ${fee}
    ========================
    """

    bill_area.insert(tk.END, shipment)

    with open("shipments.txt", "a", encoding="utf-8") as file:
        file.write(shipment + "\n")

    clear_entries()

def clear_entries():
    name_entry.delete(0, tk.END)
    phone_entry.delete(0, tk.END)
    city_entry.delete(0, tk.END)
    product_entry.delete(0, tk.END)
    quantity_entry.delete(0, tk.END)
    weight_entry.delete(0, tk.END)
    value_entry.delete(0, tk.END)
    fee_entry.delete(0, tk.END)

def clear_bill_area():
    bill_area.delete("1.0", tk.END)

# ---------- واجهة المستخدم ----------
tk.Label(root, text="Customer Name").pack()
name_entry = tk.Entry(root)
name_entry.pack()

tk.Label(root, text="Phone Number").pack()
phone_entry = tk.Entry(root)
phone_entry.pack()

tk.Label(root, text="City").pack()
city_entry = tk.Entry(root)
city_entry.pack()

tk.Label(root, text="Product Name").pack()
product_entry = tk.Entry(root)
product_entry.pack()

tk.Label(root, text="Quantity").pack()
quantity_entry = tk.Entry(root)
quantity_entry.pack()

tk.Label(root, text="Weight (kg)").pack()
weight_entry = tk.Entry(root)
weight_entry.pack()

tk.Label(root, text="Value ($)").pack()
value_entry = tk.Entry(root)
value_entry.pack()

tk.Label(root, text="Shipping Fee ($)").pack()
fee_entry = tk.Entry(root)
fee_entry.pack()

# أزرار التحكم
tk.Button(root, text="Add Shipment", command=add_shipment, bg="green", fg="white").pack(pady=5)
tk.Button(root, text="Clear Fields", command=clear_entries).pack()
tk.Button(root, text="Clear Bill Area", command=clear_bill_area).pack()
tk.Button(root, text="Exit", command=root.quit, fg="red").pack(pady=5)

# منطقة عرض الفاتورة
bill_area = tk.Text(root, height=15, width=70)
bill_area.pack()

root.mainloop()
